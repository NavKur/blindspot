# Copy this file to .env and fill in your own values. Never commit .env.
# The only credential this project needs is the Bob API key used by headless `bob run`
# (python cli.py gonogo / exam). Create the key in the Bob web portal (scope: Inference).
BOB_API_KEY=
# Optional: path to the Bob Shell binary if it is not on PATH.
BOB_BIN=
