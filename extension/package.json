{
  "name": "bob-readiness",
  "displayName": "Bob Readiness",
  "description": "Shows where Bob is sure but wrong, and lets you send approved fixes to Bob on a new branch.",
  "version": "0.0.1",
  "publisher": "blindspot",
  "license": "MIT",
  "private": true,
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "main": "dist/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "bobReadiness.hello",
        "title": "Hello",
        "category": "Bob Readiness"
      }
    ],
    "configuration": {
      "title": "Bob Readiness",
      "properties": {
        "bobReadiness.contextPath": {
          "type": "string",
          "default": ".bob/context/readiness.json",
          "description": "Where the context file lives in the workspace."
        },
        "bobReadiness.highlightOnStartup": {
          "type": "boolean",
          "default": true,
          "description": "Show highlights when the IDE opens."
        },
        "bobReadiness.bobCommand": {
          "type": "string",
          "default": "bob run --format json",
          "description": "Headless Bob command. The prompt is passed as the last argument and on stdin."
        },
        "bobReadiness.useFakeBob": {
          "type": "boolean",
          "default": true,
          "description": "Use scripts/fake-bob.js instead of real Bob. Real Bob costs Bobcoins."
        },
        "bobReadiness.testCommand": {
          "type": "string",
          "default": "pytest -q",
          "description": "Run after Bob makes changes."
        },
        "bobReadiness.baseBranch": {
          "type": "string",
          "default": "main",
          "description": "Branch to return to when discarding Bob's changes."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "lint": "eslint .",
    "vscode:prepublish": "npm run build",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^4.0.0",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "zod": "^4.6.5"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/NavKur/blindspot"
  }
}
